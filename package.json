{
  "name": "@wesley-0808/theme-palette-generator",
  "private": false,
  "version": "0.2.0",
  "author": "Wesley",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wesley-0808/ThemePaletteGenerator.git"
  },
  "main": "dist/lib/index.js",
  "module": "dist/lib/index.js",
  "types": "dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "files": [
    "dist/lib"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "build:lib": "rm -rf dist/lib && tsc -p tsconfig.lib.json && node scripts/build-lib-index.mjs",
    "prepublishOnly": "pnpm run build:lib",
    "preview": "vite preview"
  },
  "dependencies": {
    "tdesign-vue-next": "^1.20.6",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.0"
  }
}
