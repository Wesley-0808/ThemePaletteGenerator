{
  "name": "@wesley-0808/theme-palette-generator",
  "private": true,
  "version": "1.0.0",
  "author": "Wesley",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "build:lib": "rm -rf dist/lib && tsc -p tsconfig.lib.json && node scripts/build-lib-index.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "tdesign-vue-next": "^1.20.6",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.0"
  }
}
